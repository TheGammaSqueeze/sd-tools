#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
  uint id = gl_GlobalInvocationID.x;
  float a = data[id];
  float b = 1.0000001;
  float c = 0.9999999;
  for (uint i = 0u; i < pc.iters; i++) {
    a = fma(a, b, c);
    a = fma(a, c, b);
    a = fma(a, b, c);
    a = fma(a, c, b);
  }
  data[id] = a;
}
