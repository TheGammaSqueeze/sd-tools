# External heavy tools fetched by scripts/setup.sh
/external/

# Build scratch
*.pyc
__pycache__/
/tmp/
*.log

# Decompressed UEFI FV (regenerate via tools/fw/extract_uefi.sh)
/modified/uefi_ext/

# Vendored abie build artifacts (regenerate with third_party/abie/gradlew build)
/third_party/abie/**/build/
/third_party/abie/.gradle/
/third_party/abie/build/

# Large regenerable repacked images (produced by scripts/repack_vendor_boot.sh)
/modified/firmware/*vendor_boot*.img

# Regenerable Turnip-swapped vendor images
/modified/vendor*.img
vendor_turnip*.img
